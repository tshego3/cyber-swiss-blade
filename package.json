{
  "name": "cyber-swiss-blade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src worker/src shared",
    "test": "vitest run",
    "licenses": "node scripts/check-licenses.mjs",
    "worker:dev": "cd worker && npx wrangler@4.151.3 dev",
    "worker:deploy": "cd worker && npx wrangler@4.151.3 deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
